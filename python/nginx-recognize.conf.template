# Generated by python/setup_config.py: contains crop_link_secret, keep it root:nginx 0640.
# Installed as /etc/nginx/recognize/recognize.conf and included inside the Nextcloud
# server block with:  include /etc/nginx/recognize/*.conf;
# ^~ so the server's `\.(jpg|...)$` regex location never takes these.

location ^~ /recognize-api/ {
    proxy_pass http://127.0.0.1:__API_PORT__/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
}

location ^~ /recognize-faces/ {
    secure_link $arg_md5,$arg_expires;
    secure_link_md5 "$secure_link_expires$uri __CROP_LINK_SECRET__";
    # "" = bad or missing signature, "0" = expired (python/api_server.py crop_url).
    if ($secure_link = "") { return 403; }
    if ($secure_link = "0") { return 410; }
    alias __CROP_ROOT__/;
    # Any add_header here drops all the server-level ones: these are copied from nextcloud.conf.
    add_header Cache-Control "private, max-age=21600";
    add_header X-Content-Type-Options nosniff;
    add_header X-Robots-Tag "noindex, nofollow";
    add_header Referrer-Policy no-referrer always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    access_log off;
}

# Defense in depth: the app's python/ dir (nc_config.json holds the DB password) is never served.
location ^~ /apps/recognize/python/ { deny all; }
