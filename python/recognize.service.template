[Unit]
Description=Nextcloud Recognize ML Service
After=network.target mysql.service postgresql.service
Wants=network.target

# StartLimit* MUST live in [Unit]. Placed in [Service] systemd ignores
# StartLimitIntervalSec entirely (falling back to the 10s default), so with
# RestartSec=30 the burst limit can never be reached and a broken service
# restarts forever instead of entering the failed state. That is exactly how
# a crash loop ran ~61k times over 21 days without ever showing as failed.
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__PYTHON_DIR__
ExecStart=__PYTHON_BIN__ service.py __CONFIG_PATH__ --models-dir __MODELS_DIR__ --ffmpeg __FFMPEG_BIN__
Restart=on-failure
RestartSec=30

# GPU environment
Environment=LD_LIBRARY_PATH=__NVIDIA_LIB_PATH__
Environment=CUDA_VISIBLE_DEVICES=__CUDA_DEVICES__
Environment=ORT_TENSORRT_CACHE=__MODELS_DIR__/.ort_cache
Environment=MPLCONFIGDIR=/tmp/matplotlib
# apache's home (/usr/share/httpd) is not writable, so onnxruntime logs
# "Failed to persist telemetry device ID" on every start. PrivateTmp=true
# gives this service its own /tmp, so point HOME there.
Environment=HOME=/tmp
# insightface 1.0.1 calls skimage's deprecated SimilarityTransform.estimate
# in its face-alignment path. Harmless today, noisy on every face; the real
# guard is the scikit-image<2.2 pin in setup_config.py, since the call is
# removed in 2.2 and face alignment would break outright.
Environment=PYTHONWARNINGS=ignore::FutureWarning:insightface.utils.face_align

# GPU device access (render group for /dev/dri, video for some drivers)
SupplementaryGroups=video render

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=__DATA_DIR__ __MODELS_DIR__

# Resource limits
MemoryMax=8G
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
